{
  "name": "resonance-vault",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "description": "Offline music library and artwork gallery",
  "author": "eryuemu <eryuemu@users.noreply.github.com>",
  "type": "module",
  "main": "desktop/main.cjs",
  "desktopName": "resonance-vault.desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:desktop": "tsc && vite build --mode desktop",
    "desktop:prepare": "npm run build:desktop && cargo build --locked --release --manifest-path native/Cargo.toml",
    "desktop:dev": "npm run desktop:prepare && npm run desktop:start",
    "desktop:start": "electron .",
    "desktop:build": "npm run desktop:prepare && electron-builder --publish never",
    "test:library": "cargo test --locked --manifest-path native/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
